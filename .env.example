# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter AI API calls (photo vision analysis).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OpenRouter Vision Models (ordered primary, secondary, tertiary)
OPENROUTER_MODEL_VISION_PRIMARY="google/gemini-2.0-flash-001"
OPENROUTER_MODEL_VISION_SECONDARY="openai/gpt-4o-mini"
OPENROUTER_MODEL_VISION_TERTIARY="google/gemini-flash-1.5"

# Upstash Redis for rate limiting and leads storage on Vercel serverless
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Admin Token for exporting leads via GET /api/leads/export
ADMIN_TOKEN="your_secure_admin_bearer_token"
