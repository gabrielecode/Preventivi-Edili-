# ==============================================================================
# Preventivatore Edile Multilingua - Environment Variables
# ==============================================================================

# OPENROUTER_API_KEY: Chiave API per OpenRouter (chat completions per stime edili e analisi foto)
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: URL dove è ospitata l'applicazione (inviato come HTTP-Referer a OpenRouter)
APP_URL="MY_APP_URL"

# ==============================================================================
# Catene di Fallback OpenRouter (Task 11a)
# ==============================================================================
# Le chiamate AI passano per l'helper centralizzato runChain(task, messages, schema).
# La catena prova i modelli in sequenza: se un modello fallisce (timeout, errori 429, 402,
# 408, 5xx, risposta vuota o JSON non valido dopo 1 riparazione), passa automaticamente
# al modello successivo dopo 500ms di pausa.
#
# COME MODIFICARE O AGGIUNGERE MODELLI:
# 1. Consulta il catalogo ufficiale e aggiornato di OpenRouter:
#    https://openrouter.ai/api/v1/models oppure https://openrouter.ai/models
# 2. Inserisci gli ID esatti dei modelli separati da virgole, senza spazi superflui.
# 3. Ordina sempre dal modello più performante/preferito al modello di emergenza:
#    - Per TEXT: inserisci prima modelli commerciali affidabili, poi modelli con suffisso ':free'.
#    - Per VISION: inserisci UNICAMENTE modelli multimodali che supportano input di immagini.
# 4. Nota: non inserire mai modelli privi di visione nella catena AI_CHAIN_VISION.
#    I modelli della catena AI_CHAIN_TEXT non ricevono mai foto (le immagini vengono rimosse).

# Catena AI per generazione testi e preventivi (solo testo).
# Modelli predefiniti:
# 1. google/gemini-2.5-flash: Veloce, eccellente ragionamento e supporto structured output
# 2. meta-llama/llama-3.3-70b-instruct: Modello open flagship di Meta da 70B, affidabile
# 3. google/gemma-4-31b-it:free: Il modello gratuito più capace di Google (31B parametri)
# 4. nvidia/nemotron-3-ultra-550b-a55b:free: Modello gratuito ad altissima capacità NVIDIA (550B MoE)
# 5. google/gemma-4-26b-a4b-it:free: Modello gratuito MoE Google compatto e reattivo
AI_CHAIN_TEXT="google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free"

# Catena AI per analisi visione foto di cantiere (solo modelli che accettano immagini).
# Modelli predefiniti:
# 1. google/gemini-2.5-flash: Analisi visiva multimodale precisa di superfici, crepe e difetti
# 2. google/gemma-4-31b-it:free: Modello gratuito con supporto visivo multimodale verificato
AI_CHAIN_VISION="google/gemini-2.5-flash,google/gemma-4-31b-it:free"

# Timeout per singolo tentativo di modello in millisecondi (default 60000 = 60 secondi)
FALLBACK_TIMEOUT_MS="60000"

# Budget temporale massimo per l'intera catena in millisecondi (default 250000 = 250 secondi).
# Deve rimanere sotto la configurazione maxDuration (300s) della serverless function.
# Se prima di un tentativo il tempo residuo è inferiore a 20s, la catena si arresta
# e attiva la degradazione graziosa restituendo i dati calcolati deterministici.
TOTAL_BUDGET_MS="250000"

# Durata della pausa Circuit Breaker in millisecondi (Task 11b - default 300000 = 5 minuti).
# Se un modello fallisce 2 volte consecutive, viene messo in pausa per questo intervallo
# e saltato nelle richieste successive. Se TUTTI i modelli sono in pausa, le pause vengono
# ignorate e la catena viene comunque tentata in ordine.
MODEL_COOLDOWN_MS="300000"

# ==============================================================================
# Upstash Redis per Rate Limiting e Archiviazione Lead (Serverless Vercel)
# ==============================================================================
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Admin Bearer Token per esportare i lead via GET /api/leads/export
ADMIN_TOKEN="your_secure_admin_bearer_token"
