rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Admin check: Only if user document exists and has admin role
    // Bootstrapped admin: user gestsocialgabriele@gmail.com
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'gestsocialgabriele@gmail.com' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 2. Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             data.createdAt is timestamp;
    }

    function isValidEstimate(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.data is map &&
             data.createdAt is timestamp;
    }

    // 3. Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin']);
      // Admins can promote/demote (except themselves or based on logic) - simplified for now
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']);
    }

    match /estimates/{estimateId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        (query.limit <= 100 && resource.data.userId == request.auth.uid) || isAdmin()
      );
      allow create: if isSignedIn() && isValidEstimate(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && 
                    isValidEstimate(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']) &&
                    incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
